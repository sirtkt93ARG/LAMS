{
  "realm": "matheval",
  "enabled": true,
  "attributes": { "unmanagedAttributePolicy": "ENABLED" },
  "roles": { "realm": [ { "name": "teacher" }, { "name": "admin" } ] },
  "clients": [
    {
      "clientId": "matheval-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        { "name": "tenant_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String",
                      "access.token.claim": "true", "id.token.claim": "true" } },
        { "name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "matheval-api", "access.token.claim": "true", "id.token.claim": "false" } }
      ]
    }
  ],
  "users": [
    { "username": "alumno1", "enabled": true, "attributes": { "tenant_id": ["escuela-1"] },
      "credentials": [ { "type": "password", "value": "cambiar", "temporary": true } ] },
    { "username": "docente1", "enabled": true, "attributes": { "tenant_id": ["escuela-1"] },
      "realmRoles": ["teacher"],
      "credentials": [ { "type": "password", "value": "cambiar", "temporary": true } ] }
  ]
}
