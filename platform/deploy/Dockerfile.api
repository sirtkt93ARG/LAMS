FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
COPY api ./api
COPY data ./data
RUN pip install --no-cache-dir ".[api]" \
    && addgroup --system app \
    && adduser --system --ingroup app app
ENV PYTHONPATH=/app/src
USER app
EXPOSE 8000
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
