FROM node:22-alpine AS build
WORKDIR /app
COPY web/package.json ./
RUN npm install
COPY web ./
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_DEV=0
ARG NEXT_PUBLIC_KC_URL=http://localhost:8080
ARG NEXT_PUBLIC_KC_REALM=matheval
ARG NEXT_PUBLIC_KC_CLIENT=matheval-web
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEV=$NEXT_PUBLIC_DEV \
    NEXT_PUBLIC_KC_URL=$NEXT_PUBLIC_KC_URL \
    NEXT_PUBLIC_KC_REALM=$NEXT_PUBLIC_KC_REALM \
    NEXT_PUBLIC_KC_CLIENT=$NEXT_PUBLIC_KC_CLIENT
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
